# =================================================================
# RevenueShield Environment Configuration
# Razorpay AI Buildathon 2026 — Track 03: AI Revenue Recovery
# =================================================================

# Razorpay Test Mode Credentials (Get these from Razorpay Dashboard -> Settings -> API Keys)
# NOTE: Use TEST MODE credentials only (rzp_test_...)
RAZORPAY_KEY_ID=your_razorpay_test_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Application Runtime Configuration
APP_ENV=development
# Modes: TEST_MODE (uses Razorpay Test API) | DEMO_SIMULATION (synthetic offline execution)
APP_MODE=TEST_MODE

# Server & Network Configuration
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501
LOG_LEVEL=INFO

# Storage & Paths (relative to project root or absolute paths)
DATABASE_URL=sqlite:///./revenueshield.db
MODELS_DIR=models
DATA_DIR=data

# Deterministic Policy Engine Configuration
POLICY_MAX_TRANSACTION_AMOUNT=500000.0
POLICY_MIN_EXPECTED_VALUE=0.0
POLICY_MAX_ESCALATION_AMOUNT=100000.0
POLICY_HIGH_RISK_EV_THRESHOLD=100.0
POLICY_LOW_RISK_EV_THRESHOLD=1000.0

# Intervention Action Costs (in INR)
COST_RETRY=2.0
COST_REMINDER=1.0
COST_ESCALATION=15.0
